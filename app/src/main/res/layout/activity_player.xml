<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:shutter_background_color="@android:color/black"
        app:use_controller="false" />

    <ProgressBar
        android:id="@+id/buffering"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent_2" />

    <!-- "Izvor 1 ne radi · probam izvor 2 od 3…" -->
    <TextView
        android:id="@+id/source_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="84dp"
        android:background="@drawable/bg_panel"
        android:paddingStart="18dp"
        android:paddingTop="9dp"
        android:paddingEnd="18dp"
        android:paddingBottom="9dp"
        android:tag="medium"
        android:textColor="@color/text"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Greska -->
    <LinearLayout
        android:id="@+id/error_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_panel"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="28dp"
        android:paddingEnd="40dp"
        android:paddingBottom="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="bold"
            android:text="Kanal trenutno nije dostupan"
            android:textColor="@color/text"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxWidth="460dp"
            android:textColor="@color/text_2"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:tag="medium"
            android:text="▲ ▼  drugi kanal     OK  lista kanala"
            android:textColor="@color/accent_2"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Info traka -->
    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/bg_overlay_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="48dp"
            android:paddingTop="34dp"
            android:paddingEnd="48dp"
            android:paddingBottom="70dp">

            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="74dp"
                android:background="@drawable/bg_logo_tile">

                <TextView
                    android:id="@+id/ov_initials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:tag="bold"
                    android:textColor="#D9FFFFFF"
                    android:textSize="24sp" />

                <ImageView
                    android:id="@+id/ov_logo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_live"
                        android:letterSpacing="0.1"
                        android:paddingStart="7dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="7dp"
                        android:paddingBottom="2dp"
                        android:tag="bold"
                        android:text="UŽIVO"
                        android:textColor="@android:color/white"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/ov_quality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip"
                        android:paddingStart="7dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="7dp"
                        android:paddingBottom="2dp"
                        android:tag="semibold"
                        android:textColor="@color/text"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/ov_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:tag="medium"
                        android:textColor="@color/text_2"
                        android:textSize="12sp" />

                    <ImageView
                        android:id="@+id/ov_fav"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="10dp"
                        android:src="@drawable/ic_star"
                        android:tint="@color/gold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ov_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:tag="bold"
                    android:textColor="@color/text"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/ov_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_2"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/ov_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="semibold"
                android:textColor="@color/text"
                android:textSize="30sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_overlay_bottom"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="60dp"
            android:paddingBottom="30dp">

            <TextView
                android:id="@+id/ov_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="medium"
                android:text="▲ ▼  promijeni kanal      OK  lista kanala      drži OK  favorit"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Lista kanala u plejeru -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="420dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:layout_margin="22dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:paddingTop="22dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/panel_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:tag="bold"
            android:textColor="@color/text"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/panel_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textColor="@color/text_3"
            android:textSize="12sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/panel_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp"
            android:scrollbars="none" />
    </LinearLayout>
</FrameLayout>
