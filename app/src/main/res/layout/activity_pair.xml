<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="460dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="bold"
                android:text="Poveži TV sa sajtom"
                android:textColor="@color/text"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/pair_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/text_2"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/pair_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_logo_tile"
                android:letterSpacing="0.25"
                android:paddingStart="26dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp"
                android:tag="bold"
                android:text="······"
                android:textColor="@color/text"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/pair_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/text_3"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/pair_back"
                style="@style/PillButton"
                android:layout_marginTop="24dp"
                android:text="Nazad" />
        </LinearLayout>

        <!-- QR kod: skeniraj telefonom, otvori sajt sa vec upisanim kodom -->
        <FrameLayout
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginStart="56dp"
            android:background="@drawable/bg_qr">

            <ImageView
                android:id="@+id/pair_qr"
                android:layout_width="248dp"
                android:layout_height="248dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter" />

            <ProgressBar
                android:id="@+id/pair_loading"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/bg" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
