<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:shutter_background_color="@android:color/black"
        app:use_controller="false" />

    <ProgressBar
        android:id="@+id/buffering"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/text"
        android:visibility="gone" />

    <!-- pauza -->
    <TextView
        android:id="@+id/pause_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_chip"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="22dp"
        android:paddingBottom="12dp"
        android:tag="semibold"
        android:text="❚❚  Pauza"
        android:textColor="@color/text"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- gornji dio: naslov -->
    <LinearLayout
        android:id="@+id/ov_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_overlay_top"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="36dp"
        android:paddingEnd="56dp"
        android:paddingBottom="60dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/ov_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:tag="bold"
            android:textColor="@color/text"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/ov_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_2"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- donji dio: vrijeme i traka -->
    <LinearLayout
        android:id="@+id/ov_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_overlay_bottom"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="70dp"
        android:paddingEnd="56dp"
        android:paddingBottom="36dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ov_pos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="72dp"
                android:tag="medium"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <ProgressBar
                android:id="@+id/ov_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressDrawable="@drawable/progress_player" />

            <TextView
                android:id="@+id/ov_dur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:minWidth="72dp"
                android:tag="medium"
                android:textColor="@color/text_2"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ov_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="OK  pauza   ·   ◀ ▶  premotaj   ·   ▼  titlovi i zvuk"
            android:textColor="@color/text_3"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- poruke (npr. "Sljedeća epizoda", "Ponovo se povezujem") -->
    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_chip"
        android:paddingStart="16dp"
        android:paddingTop="9dp"
        android:paddingEnd="16dp"
        android:paddingBottom="9dp"
        android:textColor="@color/text"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- panel: titlovi i zvuk -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="420dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_margin="24dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/panel_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingTop="22dp"
            android:paddingEnd="24dp"
            android:tag="bold"
            android:text="Titlovi i zvuk"
            android:textColor="@color/text"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/panel_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textColor="@color/text_3"
            android:textSize="13sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/panel_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp"
            android:scrollbars="none" />

        <ProgressBar
            android:id="@+id/panel_loading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />
    </LinearLayout>

    <!-- greska -->
    <LinearLayout
        android:id="@+id/error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="semibold"
            android:text="Ne mogu pustiti"
            android:textColor="@color/text"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxWidth="520dp"
            android:textColor="@color/text_2"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
