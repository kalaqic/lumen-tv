<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="640dp"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:clipToPadding="false"
        android:paddingTop="48dp"
        android:paddingBottom="48dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="bold"
                android:text="Liste"
                android:textColor="@color/text"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/lists_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_2"
                android:textSize="14sp" />

            <!-- povezan / poveži TV -->
            <LinearLayout
                android:id="@+id/row_pair"
                style="@style/OptionRow"
                android:layout_marginTop="20dp">

                <TextView
                    android:id="@+id/pair_title"
                    style="@style/OptionTitle" />

                <TextView
                    android:id="@+id/pair_sub"
                    style="@style/OptionSub" />
            </LinearLayout>

            <TextView
                style="@style/SectionHeader"
                android:text="MOJE PRIJAVE (XTREAM)" />

            <LinearLayout
                android:id="@+id/logins_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/SectionHeader"
                android:text="BESPLATNI KANALI · LINKOVI BEZ PRIJAVE" />

            <LinearLayout
                android:id="@+id/links_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/SectionHeader"
                android:text="TITLOVI SA INTERNETA" />

            <TextView
                android:id="@+id/subs_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:textColor="@color/text_3"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btn_done"
                style="@style/PillButton"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:text="Gotovo" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
