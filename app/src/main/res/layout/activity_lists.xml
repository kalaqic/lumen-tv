<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="640dp"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:clipToPadding="false"
        android:paddingTop="48dp"
        android:paddingBottom="48dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="bold"
                android:text="Liste"
                android:textColor="@color/text"
                android:textSize="28sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="Prijave i linkovi bez prijave su odvojeni. Sve prijave su zajedno u „Moje prijave“. Pritisni OK na listi dvaput da je ukloniš."
                android:textColor="@color/text_2"
                android:textSize="14sp" />

            <TextView
                style="@style/SectionHeader"
                android:text="MOJE PRIJAVE (XTREAM)" />

            <LinearLayout
                android:id="@+id/logins_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/add_login"
                style="@style/OptionRow"
                android:layout_marginTop="8dp">

                <TextView
                    style="@style/OptionTitle"
                    android:text="+  Dodaj prijavu" />

                <TextView
                    style="@style/OptionSub"
                    android:text="Server, korisničko ime i lozinka, ili cijeli get.php link" />
            </LinearLayout>

            <TextView
                style="@style/SectionHeader"
                android:text="BESPLATNI KANALI · LINKOVI BEZ PRIJAVE" />

            <LinearLayout
                android:id="@+id/links_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/add_link"
                style="@style/OptionRow"
                android:layout_marginTop="8dp">

                <TextView
                    style="@style/OptionTitle"
                    android:text="+  Dodaj M3U link" />

                <TextView
                    style="@style/OptionSub"
                    android:text="Javna plejlista koja ne traži prijavu" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_done"
                style="@style/PillButton"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:text="Gotovo" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
