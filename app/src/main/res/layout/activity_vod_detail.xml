<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- slika iz filma preko cijelog ekrana, zatamnjena -->
    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.55"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim_detail" />

    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim_bottom" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="56dp"
        android:paddingTop="48dp"
        android:paddingEnd="56dp"
        android:paddingBottom="32dp">

        <FrameLayout
            android:id="@+id/poster_box"
            android:layout_width="210dp"
            android:layout_height="315dp"
            android:background="@drawable/bg_logo_tile">

            <TextView
                android:id="@+id/poster_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="14dp"
                android:tag="semibold"
                android:textColor="@color/text_2"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/poster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="40dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:tag="bold"
                android:textColor="@color/text"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:tag="medium"
                android:textColor="@color/text_2"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/plot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:ellipsize="end"
                android:lineSpacingExtra="3dp"
                android:maxLines="6"
                android:maxWidth="760dp"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/people"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="3"
                android:maxWidth="760dp"
                android:textColor="@color/text_3"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_play"
                    style="@style/PillButton"
                    android:background="@drawable/bg_button_primary"
                    android:drawableStart="@drawable/ic_play_small"
                    android:drawablePadding="8dp"
                    android:paddingStart="20dp"
                    android:text="Pusti" />

                <TextView
                    android:id="@+id/btn_restart"
                    style="@style/PillButton"
                    android:layout_marginStart="12dp"
                    android:text="Od početka"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btn_trailer"
                    style="@style/PillButton"
                    android:layout_marginStart="12dp"
                    android:text="Trailer"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- serije: sezone i epizode -->
            <LinearLayout
                android:id="@+id/series_box"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="20dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/seasons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:scrollbars="none" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/episodes"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="10dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:fadingEdgeLength="30dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="16dp"
                    android:requiresFadingEdge="vertical"
                    android:scrollbars="none" />
            </LinearLayout>

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/text_3"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
