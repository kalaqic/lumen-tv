<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="620dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_chip_accent">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="1dp"
                    android:src="@drawable/ic_play" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:tag="bold"
                android:text="Dobro došli u Lumen TV"
                android:textColor="@color/text"
                android:textSize="26sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Kako želiš gledati?"
            android:textColor="@color/text_2"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/opt_xtream"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="semibold"
                android:text="Xtream prijava"
                android:textColor="@color/text"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unesi podatke svoje IPTV usluge (host, korisničko ime, lozinka)"
                android:textColor="@color/text_3"
                android:textSize="12.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/opt_free"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="semibold"
                android:text="Besplatni balkanski kanali"
                android:textColor="@color/text"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Javni streamovi televizija, podijeljeni po državama"
                android:textColor="@color/text_3"
                android:textSize="12.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/opt_skip"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:tag="medium"
            android:text="Preskoči"
            android:textColor="@color/text_2"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
