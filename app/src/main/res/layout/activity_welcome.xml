<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="620dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_chip_accent">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="1dp"
                    android:src="@drawable/ic_play" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:tag="bold"
                android:text="Lumen TV"
                android:textColor="@color/text"
                android:textSize="28sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Kako želiš gledati?"
            android:textColor="@color/text_2"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/current_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/accent_2"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Besplatni kanali -->
        <LinearLayout
            android:id="@+id/opt_free"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="semibold"
                android:text="Besplatni kanali"
                android:textColor="@color/text"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Javni streamovi televizija · BiH, Srbija, Hrvatska i ostale"
                android:textColor="@color/text_3"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Sacuvana prijava (samo ako postoji) -->
        <LinearLayout
            android:id="@+id/opt_xtream_saved"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/opt_xtream_saved_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:tag="semibold"
                android:textColor="@color/text"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Nastavi sa sačuvanom prijavom, bez kucanja"
                android:textColor="@color/text_3"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Nova Xtream prijava -->
        <LinearLayout
            android:id="@+id/opt_xtream"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/opt_xtream_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="semibold"
                android:text="Xtream prijava"
                android:textColor="@color/text"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Server, korisničko ime i lozinka tvoje IPTV usluge"
                android:textColor="@color/text_3"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/opt_back"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:tag="medium"
            android:text="Nazad"
            android:textColor="@color/text_2"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
